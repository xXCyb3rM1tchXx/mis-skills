{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CreditAuthorization",
  "type": "object",
  "required": ["provider","operation","active_account","contacts","fields","max_credits","single_use","approved_by_human"],
  "properties": {
    "provider": {"type":"string"},
    "operation": {"type":"string"},
    "active_account": {"type":"string"},
    "contacts": {"type":"array","minItems":1,"items":{"type":"string"}},
    "fields": {"type":"array","minItems":1,"items":{"type":"string"}},
    "max_credits": {"type":"number","minimum":0},
    "single_use": {"const":true},
    "approved_by_human": {"const":true},
    "job_id": {"type":["string","null"]}
  },
  "additionalProperties": true
}